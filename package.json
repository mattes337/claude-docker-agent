{
  "name": "claude-docker-agent",
  "version": "1.0.0",
  "description": "Multi-session Docker container management system for Claude Code",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testPathIgnorePatterns=frontend/",
    "test:backend": "jest --testPathIgnorePatterns=frontend/",
    "test:frontend": "cd frontend && npm test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "install:frontend": "cd frontend && npm install",
    "dev:frontend": "cd frontend && npm start",
    "docker:build": "docker build -t claude-docker-agent .",
    "docker:run": "docker run -p 3000:3000 -v /var/run/docker.sock:/var/run/docker.sock claude-docker-agent",
    "postinstall": "npm run install:frontend && npm run build:frontend"
  },
  "keywords": [
    "claude",
    "docker",
    "containers",
    "ai",
    "development",
    "git",
    "session-management"
  ],
  "author": "Claude Docker Agent Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "fs-extra": "^11.1.1",
    "dockerode": "^4.0.0",
    "tar-stream": "^3.1.6",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "setupFilesAfterEnv": ["<rootDir>/test/setup.js"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/claude-docker-agent.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/claude-docker-agent/issues"
  },
  "homepage": "https://github.com/your-org/claude-docker-agent#readme"
}
