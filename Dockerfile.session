# Claude Session Container - Minimal build for slow networks
FROM node:20-alpine

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# Install minimal system dependencies
RUN apk add --no-cache \
    git \
    python3 \
    py3-pip \
    bash \
    vim \
    curl \
    wget

# Install minimal Python packages
RUN pip3 install --no-cache-dir --break-system-packages \
    requests \
    flask \
    fastapi

# Install minimal Node.js tools
RUN npm install -g \
    typescript \
    ts-node

# Install Claude CLI properly
RUN npm install -g @anthropic-ai/claude-code

# Create workspace and user
RUN mkdir -p /workspace \
    && adduser -D -s /bin/bash claude

# Set up git configuration
RUN git config --global init.defaultBranch main \
    && git config --global user.name "Claude Session" \
    && git config --global user.email "claude@session.local"

# Switch to claude user
USER claude
WORKDIR /workspace

# Set up environment
RUN echo 'export CLAUDE_SESSION=true' >> ~/.bashrc \
    && echo 'PS1="🤖 claude@session:\w$ "' >> ~/.bashrc

# Default command
CMD ["bash", "-l"]
