# Claude Docker Agent Configuration

# Server Configuration
NODE_ENV=development
PORT=3000

# Claude CLI Authentication (uses ~/.claude/ subscription auth files)

# Docker Configuration
CLAUDE_BASE_IMAGE=claude-session:latest
DOCKER_NETWORK=claude-network

# Workspace Configuration
WORKSPACES_DIR=./workspaces
CLEANUP_WORKSPACES=false

# Security Configuration
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
MAX_SESSIONS_PER_USER=10
SESSION_TIMEOUT_HOURS=24
AUTO_CLEANUP_HOURS=48

# Container Resource Limits
DEFAULT_MEMORY_LIMIT=1073741824
DEFAULT_CPU_SHARES=1024
MAX_MEMORY_LIMIT=4294967296
MAX_CPU_SHARES=4096

# Git Configuration
GIT_TIMEOUT_SECONDS=300
GIT_CLONE_DEPTH=1

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=100
